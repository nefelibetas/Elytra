{
  "name": "elytra",
  "private": true,
  "version": "1.1.0",
  "description": "A modern, lightweight Minecraft launcher built with Tauri and Rust.",
  "author": "BridgeFishDev",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefelibetas/ElytraLauncher.git"
  },
  "homepage": "https://github.com/nefelibetas/ElytraLauncher#readme",
  "bugs": {
    "url": "https://github.com/nefelibetas/ElytraLauncher/issues"
  },
  "type": "module",
  "browserslist": [
    "chrome 111",
    "safari 16.4"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && pnpm lint:css && vite build",
    "build:frontend": "vite build",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "vue-tsc --noEmit && pnpm lint:css && tauri build"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
