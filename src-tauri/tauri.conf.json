{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elytra Launcher",
  "version": "1.0.0",
  "identifier": "xyz.fish.elytra",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Elytra Launcher",
        "width": 840,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BridgeFishDev",
    "copyright": "Copyright © 2026 BridgeFishDev",
    "shortDescription": "A cross-platform lightweight Minecraft launcher",
    "longDescription": "A modern, lightweight Minecraft launcher built with Tauri and Rust, providing a great option for Linux and cross-platform users.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
